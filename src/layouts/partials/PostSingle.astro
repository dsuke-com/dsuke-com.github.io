---
import AdDisclosure from "@/shortcodes/AdDisclosure.astro";
import AuthorBox from "@/components/AuthorBox.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import PostMeta from "@/components/PostMeta.astro";
import PostNav from "@/components/PostNav.astro";
import Share from "@/components/Share.astro";
import Sidebar from "@/components/Sidebar.astro";
import SimilarPosts from "@/components/SimilarPosts.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import config from "@/config/config.json";
import { getSinglePage } from "@/lib/contentParser.astro";
import dateFormat from "@/lib/utils/dateFormat";
import similerItems from "@/lib/utils/similarItems";
import { sortByDate } from "@/lib/utils/sortFunctions";
import { humanize, markdownify, slugify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
import { render } from "astro:content";

const posts = await getSinglePage("posts");
const { post } = Astro.props;
const similarPosts = similerItems(post, posts, post.id);
const { Content, headings } = await render(post);
const {
  title,
  description,
  categories,
  image,
  eyecatchAlt,
  date,
  tags,
  updated,
  affiliate,
  tripDate,
  location,
  totalCost,
  readingTime,
} = post.data;

// 前後の記事：公開日の新しい順に並べたときの隣
const sorted = sortByDate([...posts]);
const index = sorted.findIndex((p: { id: string }) => p.id === post.id);
const prev = index > 0 ? sorted[index - 1] : undefined;
const next =
  index >= 0 && index < sorted.length - 1 ? sorted[index + 1] : undefined;
---

<section class="section">
  <div class="container">
    <div class="row gx-5">
      <div class="lg:col-8">
        <Breadcrumb category={categories[0]} className="mb-5" />

        <article class="border-border bg-surface rounded-lg border p-5 md:p-9">
          <h1 set:html={markdownify(title)} class="h3 mb-5 leading-normal" />

          <!-- メタ情報：著者・公開日・更新日 -->
          <div
            class="border-border text-text-muted mb-5 flex flex-wrap items-center gap-x-4 gap-y-2 border-b pb-5 text-sm"
          >
            <span class="flex items-center gap-2">
              <span
                aria-hidden="true"
                class="bg-apricot text-text-dark flex h-7 w-7 items-center justify-center rounded-full text-xs font-bold"
                >{config.author.name.slice(0, 1)}</span
              >
              <span class="text-text-dark font-semibold"
                >{config.author.name}</span
              >
            </span>
            <span aria-hidden="true" class="text-border">·</span>
            <span
              >公開 <time datetime={date?.toISOString()}
                >{dateFormat(date)}</time
              ></span
            >
            {
              updated && (
                <>
                  <span aria-hidden="true" class="text-border">
                    ·
                  </span>
                  <span>
                    更新{" "}
                    <time datetime={updated.toISOString()}>
                      {dateFormat(updated)}
                    </time>
                  </span>
                </>
              )
            }
            {
              readingTime && (
                <>
                  <span aria-hidden="true" class="text-border">
                    ·
                  </span>
                  <span>約{readingTime}分</span>
                </>
              )
            }
          </div>

          {/* 広告表記は本文より前に出す */}
          {affiliate && <AdDisclosure />}

          <Share
            className="mb-8"
            title={title}
            description={description}
            variant="compact"
          />

          {
            image && (
              <div class="mb-8">
                <Image
                  src={image}
                  height={630}
                  width={1200}
                  alt={eyecatchAlt || title}
                  loading="eager"
                  class="w-full rounded-lg"
                />
              </div>
            )
          }

          <PostMeta
            tripDate={tripDate}
            location={location}
            totalCost={totalCost}
          />

          <TableOfContents headings={headings} />

          <div class="content mb-12 text-left">
            <Content />
          </div>

          {
            tags.length > 0 && (
              <ul class="mb-10 flex flex-wrap gap-3">
                {tags.map((tag: string) => (
                  <li>
                    <a
                      href={`/tags/${slugify(tag)}`}
                      class="border-border bg-surface text-text-dark hover:border-primary hover:text-primary block rounded-lg border px-4 py-2 text-sm font-semibold transition duration-300"
                    >
                      #{humanize(tag)}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }

          <PostNav prev={prev} next={next} className="mb-10" />

          <AuthorBox className="mb-10" />

          <Share
            className="mb-4"
            title={title}
            description={description}
            heading="この記事を共有する"
          />
        </article>
      </div>

      <div class="mt-14 lg:col-4 lg:mt-0">
        <Sidebar showAuthor={false} />
      </div>
    </div>
  </div>
</section>

<!-- あわせて読みたい -->
{
  similarPosts.length > 0 && (
    <section class="section pt-0">
      <div class="container">
        <h2 class="h4 mb-8 text-center">あわせて読みたい</h2>
        <SimilarPosts posts={similarPosts.slice(0, 3)} />
      </div>
    </section>
  )
}
