---
import Social from "@/components/Social.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import social from "@/config/social.json";
import { getSinglePage } from "@/lib/contentParser.astro";
import { getSiteCategories } from "@/lib/utils/categories";
import { markdownify } from "@/lib/utils/textConverter";

// 記事が0本のカテゴリーも導線として出す（config.json の categories が正）
const posts = await getSinglePage("posts");
const categories = getSiteCategories(posts);
const hasSocial = Array.isArray(social.main) && social.main.length > 0;
---

<footer class="bg-surface border-border border-t">
  <div class="container">
    <div class="flex flex-col gap-10 py-14 lg:flex-row lg:justify-between">
      {/* サイト名と説明 */}
      <div class="flex max-w-sm flex-col gap-3">
        <p class="font-heading text-text-dark text-xl font-semibold">
          {config.site.title}
        </p>
        <p class="text-text-muted leading-relaxed">
          {config.metadata.meta_description}
        </p>
        {
          hasSocial && (
            <Social
              source={social.main}
              className="social-icons mt-2 flex gap-3"
            />
          )
        }
      </div>

      {/* 3カラムのリンク群 */}
      <div class="flex flex-wrap gap-x-16 gap-y-10">
        <div class="flex flex-col gap-3">
          <p class="text-text-muted text-xs font-bold tracking-[0.16em]">
            カテゴリー
          </p>
          {
            categories.map((category) => (
              <a
                href={category.url}
                class="text-text-dark hover:text-primary transition"
              >
                {category.name}
              </a>
            ))
          }
        </div>

        <div class="flex flex-col gap-3">
          <p class="text-text-muted text-xs font-bold tracking-[0.16em]">
            このサイトについて
          </p>
          {
            menu.footer.map((item) => (
              <a
                href={item.url}
                class="text-text-dark hover:text-primary transition"
              >
                {item.name}
              </a>
            ))
          }
          <a
            href="/rss.xml"
            class="text-text-dark hover:text-primary transition"
          >
            RSS
          </a>
        </div>
      </div>
    </div>

    {/* 広告表記とコピーライト */}
    <div class="border-border flex flex-col gap-2 border-t py-6">
      <p class="text-text-muted max-w-2xl text-xs leading-relaxed">
        {config.params.footer_affiliate_notice}
      </p>
      <p
        set:html={markdownify(config.params.copyright)}
        class="text-text-muted text-sm"
      />
    </div>
  </div>
</footer>
