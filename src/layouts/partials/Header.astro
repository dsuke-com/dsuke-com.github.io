---
import Logo from "@/components/Logo.astro";
import Social from "@/components/Social.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import social from "@/config/social.json";
import { getSinglePage } from "@/lib/contentParser.astro";
import { getSiteCategories } from "@/lib/utils/categories";
import { IoSearch } from "react-icons/io5";

export interface ChildNavigationLink {
  name: string;
  url: string;
}

export interface NavigationLink {
  name: string;
  url?: string;
  // "categories" を指定すると config.json のカテゴリーが子項目になる
  childrenFrom?: string;
  children?: ChildNavigationLink[];
}

const posts = await getSinglePage("posts");
const categoryLinks = getSiteCategories(posts).map((c) => ({
  name: c.name,
  url: c.url,
}));

// メニュー定義に childrenFrom があれば、その場で子項目を埋める。
// カテゴリーを増やしてもメニューを直さなくて済むようにしている。
const main: NavigationLink[] = (menu.main as NavigationLink[]).map((item) =>
  item.childrenFrom === "categories"
    ? { ...item, children: categoryLinks }
    : item,
);

const hasSocial = Array.isArray(social.main) && social.main.length > 0;
---

<header class="header">
  {/* 上部のSNSバー：アカウントが設定されているときだけ出す */}
  {
    hasSocial && (
      <div class="border-border hidden border-b md:block">
        <div class="container">
          <Social
            source={social.main}
            className="flex items-center justify-center gap-1 py-2 text-text"
          />
        </div>
      </div>
    )
  }

  {/* ロゴ：md以上では中央に置き、説明文を添える */}
  <div class="hidden flex-col items-center gap-2 py-7 md:flex">
    <Logo />
    <p class="text-text-muted text-sm">{config.site.tagline}</p>
  </div>

  {/* メニュー帯 */}
  <div class="md:border-border md:bg-light md:border-y">
    <nav class="navbar container md:justify-center">
      {/* 以下 4 要素の兄弟関係は safe.css の開閉に必要なため崩さない */}
      <input id="nav-toggle" type="checkbox" class="hidden" />

      {/* モバイル用ロゴ */}
      <div class="order-0 py-4 md:hidden">
        <Logo />
      </div>

      <label
        id="show-button"
        for="nav-toggle"
        class="order-2 flex cursor-pointer items-center text-black md:order-1 md:hidden"
      >
        <svg class="h-6 fill-current" viewBox="0 0 20 20">
          <title>メニューを開く</title>
          <path d="M0 3h20v2H0V3z m0 6h20v2H0V9z m0 6h20v2H0V0z"></path>
        </svg>
      </label>
      <label
        id="hide-button"
        for="nav-toggle"
        class="order-2 hidden cursor-pointer items-center text-black md:order-1"
      >
        <svg class="h-6 fill-current" viewBox="0 0 20 20">
          <title>メニューを閉じる</title>
          <polygon
            points="11 9 22 9 22 11 11 11 11 22 9 22 9 11 -2 11 -2 9 9 9 9 -2 11 -2"
            transform="rotate(45 10 10)"></polygon>
        </svg>
      </label>

      <ul
        id="nav-menu"
        class="navbar-nav order-3 hidden w-full md:order-1 md:flex md:w-auto md:items-center md:justify-center"
      >
        {
          main.map((item, i) =>
            item.children ? (
              <li class="nav-item nav-dropdown">
                {/* クリックで開閉する。hover だけだとタッチ端末で開けないため */}
                <button
                  type="button"
                  class="nav-link nav-dropdown-toggle"
                  aria-expanded="false"
                  aria-controls={`nav-dropdown-${i}`}
                >
                  {item.name}
                  <svg
                    class="nav-dropdown-caret"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </button>
                <ul id={`nav-dropdown-${i}`} class="nav-dropdown-list" hidden>
                  {item.children.map((child) => (
                    <li class="nav-dropdown-item">
                      <a href={child.url} class="nav-dropdown-link">
                        {child.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li class="nav-item">
                <a href={item.url} class="nav-link block">
                  {item.name}
                </a>
              </li>
            ),
          )
        }
        {/* 検索：md以上ではメニューの末尾に並べる */}
        <li class="nav-item hidden md:block">
          <a
            href="/search"
            title="記事を検索"
            aria-label="記事を検索"
            class="nav-link flex items-center"
          >
            <IoSearch />
          </a>
        </li>
      </ul>

      {/* 検索：モバイルではハンバーガーの隣に出す */}
      <div class="order-1 ml-auto flex md:hidden">
        <a
          class="text-dark hover:text-primary-dark inline-block cursor-pointer p-2 text-xl transition"
          href="/search"
          title="記事を検索"
          aria-label="記事を検索"
        >
          <IoSearch />
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  // カテゴリーのドロップダウン。
  // ClientRouter でページを移動すると DOM が入れ替わるので astro:page-load で組み直す。
  // 同じ要素に二度リスナーを付けると、1クリックで開いて即閉じてしまうため
  // ボタン側は data 属性、document 側は window のフラグで二重登録を防ぐ。
  function setupNavDropdowns() {
    const toggles = document.querySelectorAll<HTMLButtonElement>(
      ".nav-dropdown-toggle",
    );

    const closeAll = (except?: Element) => {
      document
        .querySelectorAll<HTMLButtonElement>(".nav-dropdown-toggle")
        .forEach((t) => {
          if (t === except) return;
          t.setAttribute("aria-expanded", "false");
          document
            .getElementById(t.getAttribute("aria-controls") ?? "")
            ?.setAttribute("hidden", "");
        });
    };

    toggles.forEach((toggle) => {
      if (toggle.dataset.bound === "true") return;
      const list = document.getElementById(
        toggle.getAttribute("aria-controls") ?? "",
      );
      if (!list) return;
      toggle.dataset.bound = "true";

      toggle.addEventListener("click", (e) => {
        e.stopPropagation();
        const open = toggle.getAttribute("aria-expanded") === "true";
        closeAll(toggle);
        toggle.setAttribute("aria-expanded", String(!open));
        list.toggleAttribute("hidden", open);
      });
    });

    if (!window.__navDropdownDocBound) {
      window.__navDropdownDocBound = true;
      // 外側クリックと Escape で閉じる。
      // ただしドロップダウン内のリンクを押したときは閉じない。
      // ここで hidden を付けると ClientRouter の画面遷移が途中で止まる。
      document.addEventListener("click", (e) => {
        const target = e.target as Element | null;
        if (target?.closest?.(".nav-dropdown-list")) return;
        closeAll();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeAll();
      });
    }
  }

  document.addEventListener("astro:page-load", setupNavDropdowns);
</script>
