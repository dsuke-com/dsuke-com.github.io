---
import config from "@/config/config.json";

type Props = {
  title?: string;
  description?: string;
  className?: string;
  // "full" は冒頭・末尾の大きめのボタン列、"compact" はタグ横などの小さい表示
  variant?: "full" | "compact";
  heading?: string;
};

const {
  title,
  description,
  className = "",
  variant = "full",
  heading,
} = Astro.props;

const { base_url } = config.site;

// 共有対象は「今表示しているページ」そのもの。
// 以前は `${base_url}/${slug}` としており /blog/ が欠落して 404 になっていた。
const shareUrl = new URL(Astro.url.pathname, base_url).href;

// タイトルや説明文には ｜ ・ 。 & などが含まれるため、必ずエンコードして渡す
const e = encodeURIComponent;
const q = {
  url: e(shareUrl),
  title: e(title ?? ""),
  description: e(description ?? ""),
  site: e(base_url),
};

const services = [
  {
    name: "X",
    label: "X でポストする",
    href: `https://twitter.com/intent/tweet/?text=${q.title}&url=${q.url}`,
  },
  {
    name: "Facebook",
    label: "Facebook で共有する",
    href: `https://www.facebook.com/sharer/sharer.php?u=${q.url}`,
  },
  {
    name: "はてブ",
    label: "はてなブックマークに追加する",
    href: `https://b.hatena.ne.jp/entry/panel/?url=${q.url}&title=${q.title}`,
  },
  {
    name: "LINE",
    label: "LINE で送る",
    href: `https://social-plugins.line.me/lineit/share?url=${q.url}`,
  },
];

const compact = variant === "compact";
---

<div class={className}>
  {
    heading && (
      <p class="text-text-muted mb-3 text-sm font-bold tracking-wide">
        {heading}
      </p>
    )
  }
  <ul class="flex flex-wrap gap-2">
    {
      services.map((s) => (
        <li>
          <a
            href={s.href}
            aria-label={s.label}
            target="_blank"
            rel="noreferrer noopener"
            class={`border-border bg-surface text-text-dark hover:border-primary hover:text-primary flex min-h-[44px] items-center rounded-md border font-bold transition duration-300 ${compact ? "px-3 text-xs" : "px-4 text-sm"}`}
          >
            {s.name}
          </a>
        </li>
      ))
    }
    <li>
      <button
        type="button"
        data-copy-url={shareUrl}
        class={`copy-link flex min-h-[44px] items-center rounded-md border border-border bg-surface font-bold text-text-dark transition duration-300 hover:border-primary hover:text-primary ${compact ? "px-3 text-xs" : "px-4 text-sm"}`}
      >
        <span class="copy-link-label">リンクをコピー</span>
      </button>
    </li>
  </ul>
</div>

<script>
  // 「リンクをコピー」— クリップボードが使えない環境では何もしない
  document.querySelectorAll<HTMLButtonElement>(".copy-link").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const url = btn.dataset.copyUrl;
      const label = btn.querySelector(".copy-link-label");
      if (!url || !label || !navigator.clipboard) return;
      try {
        await navigator.clipboard.writeText(url);
        const before = label.textContent;
        label.textContent = "コピーしました";
        setTimeout(() => {
          label.textContent = before;
        }, 2000);
      } catch {
        // 権限がない場合などは黙って無視する
      }
    });
  });
</script>
