---
import { humanize, slugify } from "@/lib/utils/textConverter";

type Props = {
  category?: string;
  className?: string;
};

const { category, className = "" } = Astro.props;
---

<nav aria-label="パンくずリスト" class={`breadcrumb ${className}`}>
  <ol class="text-text-muted flex flex-wrap items-center gap-2 text-sm">
    <li>
      <a href="/" class="hover:text-primary-dark transition duration-300"
        >ホーム</a
      >
    </li>
    {
      category && (
        <>
          <li aria-hidden="true" class="text-text-light">
            ›
          </li>
          <li>
            <a
              href={`/categories/${slugify(category)}`}
              class="text-primary-dark font-semibold hover:underline"
            >
              {humanize(category)}
            </a>
          </li>
        </>
      )
    }
  </ol>
</nav>
