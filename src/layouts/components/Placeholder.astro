---
// 写真がまだない場所に置く控えめなプレースホルダー。
// 外部から無関係な写真を持ってこないための受け皿で、
// aspect-ratio を固定して画像差し替え時のレイアウトずれ（CLS）も防ぐ。
type Props = {
  ratio?: string;
  label?: string;
  className?: string;
};

const {
  ratio = "16 / 9",
  label = "写真を入れる場所",
  className = "",
} = Astro.props;
---

<div
  class={`placeholder ${className}`}
  style={{ aspectRatio: ratio }}
  role="img"
  aria-label={`${label}（準備中）`}
>
  <svg
    width="34"
    height="34"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
    <circle cx="8.5" cy="10" r="1.5"></circle>
    <path d="M21 16l-5-5-6.5 8"></path>
  </svg>
  <span>{label}</span>
</div>

<style>
  .placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    width: 100%;
    border: 1px dashed var(--color-border);
    border-radius: 0.5rem;
    background-color: var(--color-body);
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }
</style>
