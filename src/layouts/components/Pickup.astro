---
import config from "@/config/config.json";

type PickupItem = {
  title: string;
  description?: string;
  url: string;
  icon?: string;
};

type Props = {
  title?: string;
  className?: string;
};

const { title = "まずはここから", className = "" } = Astro.props;
const items: PickupItem[] = config.pickup ?? [];

// アイコンは線画で用意する（絵文字は使わない）
const icons: Record<string, string> = {
  window:
    '<rect x="3" y="3" width="18" height="18" rx="1.5"></rect><path d="M12 3v18"></path><path d="M3 12h18"></path>',
  layers:
    '<path d="M12 3l9 5-9 5-9-5z"></path><path d="M3 13l9 5 9-5"></path>',
  building:
    '<rect x="4" y="3" width="16" height="18" rx="1.5"></rect><path d="M9 7h2"></path><path d="M13 7h2"></path><path d="M9 11h2"></path><path d="M13 11h2"></path><path d="M10 21v-4h4v4"></path>',
  thermometer:
    '<path d="M12 14V4a2 2 0 114 0v10a4 4 0 11-4 0z" transform="translate(-2)"></path>',
  air: '<path d="M4 8h11a3.5 3.5 0 100-3.5"></path><path d="M4 14h13a3.5 3.5 0 110 3.5"></path>',
  floor:
    '<path d="M3 17h18"></path><path d="M3 21h18"></path><path d="M7 13V7"></path><path d="M12 13V4"></path><path d="M17 13V9"></path>',
};
---

{
  items.length > 0 && (
    <section class={className}>
      <div class="mb-6 flex items-center gap-3">
        <span aria-hidden="true" class="h-[22px] w-[5px] rounded bg-primary" />
        <h2 class="h4 text-text-dark">{title}</h2>
      </div>
      <div class="row gy-4 gx-4">
        {items.map((item) => (
          <div class="col-12 sm:col-6 lg:col-3">
            <a
              href={item.url}
              class="flex h-full flex-col gap-3 rounded-lg border border-border p-5 transition duration-300 hover:border-primary hover:shadow-sm"
            >
              <span
                aria-hidden="true"
                class="flex h-11 w-11 items-center justify-center rounded-[9px] bg-[#e6f6f4]"
              >
                <svg
                  width="23"
                  height="23"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="#00695f"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons[item.icon ?? ""] ?? icons.layers}
                />
              </span>
              <span class="font-bold text-text-dark">{item.title}</span>
              {item.description && (
                <span class="text-sm leading-relaxed text-text">
                  {item.description}
                </span>
              )}
            </a>
          </div>
        ))}
      </div>
    </section>
  )
}
