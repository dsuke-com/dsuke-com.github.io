---
import { getSiteCategories } from "@/lib/utils/categories";
import type { CollectionEntry } from "astro:content";
import { slugify } from "@/lib/utils/textConverter";

// 記事一覧の上に置くカテゴリーの絞り込みチップ。
// 表示中の記事に含まれるカテゴリーだけを出す（空振りするチップを作らない）。
type Props = {
  posts: CollectionEntry<"posts">[];
  className?: string;
};

const { posts, className = "" } = Astro.props;

const present = new Set(
  posts.flatMap((post) =>
    (post.data.categories ?? []).map((c: string) => slugify(c)),
  ),
);
const chips = getSiteCategories(posts).filter((c) => present.has(c.slug));
---

{
  chips.length > 1 && (
    <div
      class={`post-filter ${className}`}
      role="group"
      aria-label="カテゴリーで絞り込む"
    >
      <button
        type="button"
        class="post-filter-chip"
        data-filter=""
        aria-pressed="true"
      >
        すべて
      </button>
      {chips.map((chip) => (
        <button
          type="button"
          class="post-filter-chip"
          data-filter={chip.slug}
          aria-pressed="false"
        >
          {chip.name}
        </button>
      ))}
    </div>
  )
}

<style>
  .post-filter {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .post-filter-chip {
    min-height: 40px;
    cursor: pointer;
    border-radius: 999px;
    background-color: var(--color-surface);
    padding: 0.375rem 1.125rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-muted);
    box-shadow: inset 0 0 0 1px var(--color-border);
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .post-filter-chip:hover {
    color: var(--color-text-dark);
  }

  .post-filter-chip[aria-pressed="true"] {
    background-color: var(--color-primary);
    color: #fff;
    box-shadow: none;
  }
</style>
