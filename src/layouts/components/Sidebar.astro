---
import AuthorBox from "@/components/AuthorBox.astro";
import config from "@/config/config.json";
import { getSinglePage } from "@/lib/contentParser.astro";
import { getSiteCategories } from "@/lib/utils/categories";
import postUrl from "@/lib/utils/postUrl";

type Props = {
  className?: string;
  // 記事ページでは本文末尾に同じ内容が出るため、重複を避けて false にする
  showAuthor?: boolean;
  // トップページは本文側に同じ枠を置くため false にする
  showFeatured?: boolean;
};

const { className = "", showAuthor = true, showFeatured = true } = Astro.props;

// 注目記事は config.featured_posts に記事の id を並べて指定する。
// アクセス解析を入れるまでは自動集計ができないため手動で選ぶ。
const posts = await getSinglePage("posts");
const categories = getSiteCategories(posts);
const featuredIds: string[] = config.featured_posts ?? [];
const featured = featuredIds
  .map((id) => posts.find((p: { id: string }) => p.id === id))
  .filter(Boolean);
---

<aside class={`flex flex-col gap-10 ${className}`}>
  {showAuthor && <AuthorBox variant="compact" heading="運営者" />}

  {/* カテゴリー */}
  <div class="border-border bg-surface overflow-hidden rounded-lg border">
    <p class="bg-sage text-text-dark px-4 py-3 text-sm font-bold">カテゴリー</p>
    <ul>
      {
        categories.map((category, i) => (
          <li class={i > 0 ? "border-border border-t" : ""}>
            <a
              href={category.url}
              class="text-text-dark hover:text-primary flex min-h-[46px] items-center justify-between px-4 font-semibold transition duration-300"
            >
              {category.name}
              <span class="text-text-muted text-sm">{category.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  {/* 注目の記事 */}
  {
    showFeatured && featured.length > 0 && (
      <div class="border-border bg-surface overflow-hidden rounded-lg border">
        <p class="bg-sage text-text-dark px-4 py-3 text-sm font-bold">
          注目の記事
        </p>
        <ul class="flex flex-col gap-3 p-4">
          {featured.map((post: any, i: number) => (
            <li class="flex items-start gap-3">
              <span
                aria-hidden="true"
                class="bg-accent text-text-dark mt-[2px] flex h-6 w-6 shrink-0 items-center justify-center rounded text-xs font-bold"
              >
                {i + 1}
              </span>
              <a
                href={postUrl(post)}
                class="text-text-dark hover:text-primary-dark text-sm leading-relaxed font-semibold transition duration-300"
              >
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {/* 検索 */}
  <div class="border-border bg-surface rounded-lg border p-4">
    <label
      for="sidebar-search"
      class="text-text-dark mb-3 block text-sm font-bold">記事を検索</label
    >
    <form action="/search" method="get" class="flex gap-2">
      <input
        id="sidebar-search"
        type="search"
        name="q"
        placeholder="キーワードを入力"
        class="form-input min-h-[44px] w-full"
      />
      <button
        type="submit"
        aria-label="検索する"
        class="bg-primary hover:bg-primary-dark flex min-h-[44px] w-11 shrink-0 items-center justify-center rounded-md text-white transition duration-300"
      >
        <svg
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-4.3-4.3"></path>
        </svg>
      </button>
    </form>
  </div>
</aside>
