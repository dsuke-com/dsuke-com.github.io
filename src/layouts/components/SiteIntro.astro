---
import config from "@/config/config.json";
import { Image } from "astro:assets";

type Props = {
  className?: string;
};

const { className = "" } = Astro.props;
const { name, image, description } = config.author;
const { title } = config.site;
---

<section
  class={`rounded-lg border border-border bg-light p-6 md:p-8 ${className}`}
>
  <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
    {
      image ? (
        <Image
          src={image}
          alt={name}
          width={148}
          height={148}
          class="h-[74px] w-[74px] shrink-0 self-center rounded-full object-cover sm:self-start"
        />
      ) : (
        <span
          aria-hidden="true"
          class="flex h-[74px] w-[74px] shrink-0 items-center justify-center self-center rounded-full bg-primary text-[31px] font-bold text-white sm:self-start"
        >
          {name.slice(0, 1)}
        </span>
      )
    }
    <div class="flex flex-col gap-3">
      <h2 class="h5 text-text-dark">{title} とは</h2>
      <p class="leading-loose text-text">{description}</p>
      <a
        href="/about"
        class="text-sm font-semibold transition duration-300 hover:text-primary-dark"
        >運営者について詳しく →</a
      >
    </div>
  </div>
</section>
