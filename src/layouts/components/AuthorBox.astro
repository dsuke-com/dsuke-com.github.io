---
import config from "@/config/config.json";
import { Image } from "astro:assets";

type Props = {
  // "inline" は記事末尾、"compact" はサイドバーなどの狭い場所
  variant?: "inline" | "compact";
  className?: string;
  // 同じページに2つ置くとき（記事末尾とサイドバー）に見出しを分ける
  heading?: string;
};

const {
  variant = "inline",
  className = "",
  heading = "この記事を書いた人",
} = Astro.props;
const { name, image, description } = config.author;

const compact = variant === "compact";
const avatarSize = compact ? 64 : 84;
---

<aside
  class={`rounded-lg border border-border bg-surface ${compact ? "p-5" : "p-6"} ${className}`}
>
  <div
    class={`flex gap-5 ${compact ? "flex-col items-center text-center" : "items-start"}`}
  >
    {
      image ? (
        <Image
          src={image}
          alt={name}
          width={avatarSize * 2}
          height={avatarSize * 2}
          class="shrink-0 rounded-full object-cover"
          style={{ width: `${avatarSize}px`, height: `${avatarSize}px` }}
        />
      ) : (
        <span
          aria-hidden="true"
          class="bg-apricot text-text-dark flex shrink-0 items-center justify-center rounded-full font-bold"
          style={{
            width: `${avatarSize}px`,
            height: `${avatarSize}px`,
            fontSize: `${Math.round(avatarSize * 0.42)}px`,
          }}
        >
          {name.slice(0, 1)}
        </span>
      )
    }
    <div class="flex flex-col gap-2">
      <p class="text-primary text-xs font-bold tracking-widest">
        {heading}
      </p>
      <p class="text-text-dark text-lg font-bold">{name}</p>
      <p class="text-text-muted text-sm leading-relaxed">{description}</p>
      <div class="mt-1 flex flex-wrap gap-4 text-sm">
        <a
          href="/about"
          class="text-primary hover:text-primary-dark font-semibold transition"
          >私たちについて</a
        >
      </div>
    </div>
  </div>
</aside>
