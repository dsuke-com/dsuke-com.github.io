---
import dateFormat from "@/lib/utils/dateFormat";
import { humanize, plainify, slugify } from "@/lib/utils/textConverter";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type Props = {
  posts: CollectionEntry<"posts">[];
  className?: string;
  // 1本目を全幅で大きく見せるか（既定: 見せる）
  fluid?: boolean;
  // サイドバーがある画面では 2 列、ない画面では 3 列にできる
  columns?: 2 | 3;
};

const { className, posts, fluid, columns = 2 } = Astro.props;

const colClass = columns === 3 ? "col-12 sm:col-6 lg:col-4" : "col-12 sm:col-6";
---

<div
  class={`row gy-5 gx-4 ${className} ${posts.length == 1 ? "justify-center" : ""} `}
>
  {
    posts.map((post, i: number) => {
      const isLead = i === 0 && fluid !== false;
      return (
        <div class={isLead ? "col-12" : colClass}>
          <article class="flex h-full flex-col">
            {post.data.image && (
              <a
                href={`/blog/${post.id}`}
                class="group block overflow-hidden rounded-lg hover:text-primary-dark"
              >
                <Image
                  class="w-full transition duration-300 group-hover:scale-[1.03]"
                  src={post.data.image}
                  alt={post.data.title}
                  width={isLead ? 925 : 445}
                  height={isLead ? 475 : 230}
                />
              </a>
            )}
            <div
              class={`flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-text ${post.data.image ? "mt-5" : ""} mb-3`}
            >
              {post.data.categories.map((category) => (
                <a
                  href={`/categories/${slugify(category)}`}
                  class="font-semibold text-primary-dark transition duration-300 hover:underline"
                >
                  {humanize(category)}
                </a>
              ))}
              {post.data.date && (
                <>
                  <span aria-hidden="true" class="text-text-light">
                    ·
                  </span>
                  <span>{dateFormat(post.data.date)}</span>
                </>
              )}
            </div>
            <h3 class={isLead ? "h4 mb-3" : "h5 mb-3"}>
              <a
                href={`/blog/${post.id}`}
                class="block transition duration-300 hover:text-primary-dark"
              >
                {post.data.title}
              </a>
            </h3>
            <p class="mb-4 line-clamp-3 text-text">
              {post.data.description || plainify(post.body ?? "")}
            </p>
            <a
              href={`/blog/${post.id}`}
              class="mt-auto inline-flex min-h-[44px] items-center gap-2 self-start text-sm font-bold transition duration-300 hover:text-primary-dark"
            >
              {/* 「続きを読む」だけではリンク先が分からないため、
                  読み上げと検索エンジン向けに記事名を添える */}
              続きを読む<span class="sr-only">：{post.data.title}</span>
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.4"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M5 12h13"></path>
                <path d="M12 5l7 7-7 7"></path>
              </svg>
            </a>
          </article>
        </div>
      );
    })
  }
</div>
