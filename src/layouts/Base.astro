---
import TwSizeIndicator from "@/components/TwSizeIndicator.astro";
import config from "@/config/config.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import { ClientRouter } from "astro:transitions";

// types for frontmatters
export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  // 記事ページでは "article"
  ogType?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
}

// distructure frontmatters
const {
  title,
  meta_title,
  description,
  image,
  noindex,
  canonical,
  ogType = "website",
  publishedTime,
  modifiedTime,
} = Astro.props;

const siteUrl = Astro.site ?? new URL(config.site.base_url);

// 重複URLを作らないよう、canonical は常に1ページ1本出す。
// 明示指定がなければ、いま表示しているパスを正とする。
const canonicalUrl = canonical
  ? new URL(canonical, siteUrl).href
  : new URL(Astro.url.pathname, siteUrl).href;

const pageTitle = plainify(meta_title || title || config.site.title);
const pageDescription = plainify(
  description || config.metadata.meta_description,
);
const ogImage = new URL(image || config.metadata.meta_image, siteUrl).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <!-- favicon -->
    <link rel="shortcut icon" href={config.site.favicon} />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    {
      /* フォントは端末のものを使う（theme.json の use_system_fonts）。
        日本語の Web フォントは unicode-range で百数十分割され、合計で数MBに
        なるため読み込んでいない。リモートフォントに戻すときは theme.json の
        use_system_fonts を false にしたうえで、ここに astro:assets の
        <Font cssVariable="--font-primary" /> を並べる。 */
    }

    <!-- responsive meta -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <!-- title -->
    <title>{pageTitle}</title>

    <!-- canonical url -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- noindex robots -->
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- meta-description -->
    <meta name="description" content={pageDescription} />

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={config.site.title}
      href={new URL("/rss.xml", siteUrl).href}
    />

    <ClientRouter />

    <!-- author from config.json -->
    <meta name="author" content={config.metadata.meta_author} />

    <!-- Open Graph -->
    <meta property="og:site_name" content={config.site.title} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    {
      publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }
    {
      modifiedTime && (
        <meta
          property="article:modified_time"
          content={modifiedTime.toISOString()}
        />
      )
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <slot name="head" />
  </head>
  <body>
    <TwSizeIndicator />
    <a href="#main-content" class="skip-link">本文へ移動</a>
    <Header />
    <main id="main-content" class="min-h-[60vh]">
      <slot />
    </main>
    <Footer />
  </body>
</html>
