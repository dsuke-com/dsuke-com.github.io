---
// 商品やプランの比較表。
//
// 例:
// <CompareTable
//   caption="使った2製品の比較"
//   columns={["商品A", "商品B"]}
//   rows={[
//     { label: "価格", values: ["3,480円", "5,200円"] },
//     { label: "サイズ", values: ["90×180cm", "100×200cm"] },
//   ]}
// />
type Row = { label: string; values: string[] };

type Props = {
  columns: string[];
  rows: Row[];
  caption?: string;
  className?: string;
};

const { columns, rows, caption, className = "" } = Astro.props;
---

<figure class={`compare-table ${className}`}>
  {caption && <figcaption>{caption}</figcaption>}

  <div class="compare-table-scroll">
    <table>
      <thead>
        <tr>
          <th scope="col">項目</th>
          {columns.map((column) => <th scope="col">{column}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              {columns.map((_, i) => (
                <td>{row.values[i] ?? "—"}</td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</figure>

<style>
  .compare-table {
    margin-block: 2rem;
  }

  .compare-table figcaption {
    margin-bottom: 0.625rem;
    font-weight: 700;
    color: var(--color-text-dark);
  }

  .compare-table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
  }

  .compare-table table {
    width: 100%;
    min-width: 30rem;
    border-collapse: collapse;
    background-color: var(--color-body);
    font-size: 0.9375rem;
  }

  .compare-table th,
  .compare-table td {
    padding: 0.75rem 1rem;
    text-align: left;
    vertical-align: top;
    line-height: 1.7;
  }

  .compare-table thead th {
    background-color: var(--color-sage);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .compare-table tbody th {
    font-weight: 600;
    white-space: nowrap;
    color: var(--color-text-dark);
  }

  .compare-table tbody tr + tr {
    border-top: 1px solid var(--color-border);
  }
</style>
