---
import { Image } from "astro:assets";

// アフィリエイトの商品カード。
// 使い方（.mdx）:
//   <Item
//     name="窓用 断熱シート"
//     category="窓・断熱"
//     image="/images/items/sheet.jpg"
//     price="1,480円"
//     amazon="https://..."
//     rakuten="https://..."
//     yahoo="https://..."
//   >
//     結露は減ったが、網入りガラスには貼れなかった。
//   </Item>
//
// リンクには rel="nofollow sponsored noopener" を自動で付与する。
type Props = {
  name: string;
  category?: string;
  image?: string;
  price?: string;
  amazon?: string;
  rakuten?: string;
  yahoo?: string;
  // 広告表記を消したい場合のみ false（通常は付けたままにする）
  pr?: boolean;
};

const {
  name,
  category,
  image,
  price,
  amazon,
  rakuten,
  yahoo,
  pr = true,
} = Astro.props;

const links = [
  { label: "Amazon", href: amazon, bg: "#b45309" },
  { label: "楽天市場", href: rakuten, bg: "#bf0000" },
  { label: "Yahoo!", href: yahoo, bg: "" },
].filter((l) => Boolean(l.href));
---

<div class="item">
  <div class="item-inner">
    {
      image ? (
        <Image
          src={image}
          alt={name}
          width={312}
          height={312}
          class="item-image"
        />
      ) : (
        <span aria-hidden="true" class="item-image item-image-empty" />
      )
    }
    <div class="item-body">
      <div class="item-labels">
        {pr && <span class="item-pr">PR</span>}
        {category && <span class="item-category">{category}</span>}
      </div>
      <p class="item-name">{name}</p>
      {price && <p class="item-price">{price}</p>}
      <div class="item-comment"><slot /></div>
      {
        links.length > 0 && (
          <div class="item-links">
            {links.map((l) => (
              <a
                href={l.href}
                rel="nofollow sponsored noopener"
                target="_blank"
                class={l.bg ? "item-link" : "item-link item-link-outline"}
                style={l.bg ? { backgroundColor: l.bg } : undefined}
              >
                {l.label}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
  {
    pr && (
      <p class="item-disclosure">
        上記リンクは広告を含みます。価格は掲載時点のもので、変動する場合があります。
      </p>
    )
  }
</div>

<style>
  .item {
    margin-block: 2rem;
  }

  .item-inner {
    display: flex;
    gap: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.25rem;
  }

  .item-image {
    width: 9.75rem;
    height: 9.75rem;
    flex-shrink: 0;
    border-radius: 0.5rem;
    object-fit: cover;
  }

  .item-image-empty {
    background-color: var(--color-light);
    border: 1px solid var(--color-border);
  }

  .item-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex-grow: 1;
  }

  .item-labels {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .item-pr {
    border: 1px solid var(--color-border);
    border-radius: 0.1875rem;
    padding: 0.125rem 0.375rem;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-text);
  }

  .item-category {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .item-name {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.55;
    color: var(--color-text-dark);
  }

  .item-price {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-dark);
  }

  .item-comment :global(p) {
    margin-block: 0;
    font-size: 0.875rem;
    line-height: 1.8;
  }

  .item-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .item-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding-inline: 1.25rem;
    border-radius: 0.3125rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .item-link:hover {
    opacity: 0.85;
  }

  .item-link-outline {
    border: 1px solid var(--color-border);
    background-color: var(--color-body);
    color: var(--color-text-dark);
  }

  .item-link-outline:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    opacity: 1;
  }

  .item-disclosure {
    margin: 0.5rem 0 0;
    font-size: 0.75rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  @media (max-width: 575px) {
    .item-inner {
      flex-direction: column;
    }

    .item-image {
      width: 100%;
      height: 12rem;
    }

    .item-link {
      flex-grow: 1;
    }
  }
</style>
