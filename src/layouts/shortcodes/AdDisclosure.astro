---
import config from "@/config/config.json";

// 広告・PR表示。景品表示法上、広告であることが読者に一見して分かる必要があるため
// 記事の冒頭（本文より前）に置く。frontmatter に affiliate: true を書くと
// PostSingle が自動で出すので、記事側で手書きするのは補足したいときだけ。
type Props = {
  text?: string;
  className?: string;
};

const { text = config.params.affiliate_notice, className = "" } = Astro.props;
---

<p class={`ad-disclosure ${className}`}>
  <span class="ad-disclosure-label">PR</span>
  <span>{text}</span>
</p>

<style>
  .ad-disclosure {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin: 0 0 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    background-color: var(--color-body);
    padding: 0.75rem 1rem;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .ad-disclosure-label {
    flex-shrink: 0;
    border-radius: 0.25rem;
    background-color: var(--color-accent);
    padding: 0.125rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-text-dark);
  }
</style>
