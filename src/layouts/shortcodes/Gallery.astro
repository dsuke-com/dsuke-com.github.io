---
import Placeholder from "@/components/Placeholder.astro";

// 複数写真を並べるギャラリー。
//
// 例:
// <Gallery
//   caption="トルコで撮った写真"
//   items={[
//     { src: "/images/posts/01.jpg", alt: "カッパドキアの気球", caption: "早朝6時" },
//     { src: "/images/posts/02.jpg", alt: "イスタンブールの市場" },
//   ]}
// />
type Item = {
  src?: string;
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
};

type Props = {
  items: Item[];
  caption?: string;
  columns?: 2 | 3;
  className?: string;
};

const { items, caption, columns = 2, className = "" } = Astro.props;
---

<figure
  class={`gallery ${className}`}
  data-columns={columns}
  role="group"
  aria-label={caption ?? "写真ギャラリー"}
>
  <ul class="gallery-list">
    {
      items.map((item) => (
        <li>
          <figure>
            {item.src ? (
              <img
                src={item.src}
                alt={item.alt}
                width={item.width ?? 800}
                height={item.height ?? 600}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <Placeholder ratio="4 / 3" label={item.alt || "写真"} />
            )}
            {item.caption && <figcaption>{item.caption}</figcaption>}
          </figure>
        </li>
      ))
    }
  </ul>
  {caption && <figcaption class="gallery-caption">{caption}</figcaption>}
</figure>

<style>
  .gallery {
    margin-block: 2rem;
  }

  .gallery-list {
    display: grid;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery-list figure {
    margin: 0;
  }

  .gallery-list img {
    width: 100%;
    height: auto;
    border-radius: 0.375rem;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  .gallery-list figcaption {
    margin-top: 0.375rem;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .gallery-caption {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 560px) {
    .gallery[data-columns="2"] .gallery-list {
      grid-template-columns: repeat(2, 1fr);
    }

    .gallery[data-columns="3"] .gallery-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
