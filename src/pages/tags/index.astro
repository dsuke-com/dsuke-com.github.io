---
import Base from "@/layouts/Base.astro";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";
import { humanize } from "@/lib/utils/textConverter";

import { FaHashtag } from "react-icons/fa";

const tags = await getTaxonomy("posts", "tags");
---

<Base title={"タグ"}>
  <section class="section">
    <div class="container text-center">
      <h1 class="h2 page-heading">タグ</h1>
      <ul class="flex flex-wrap justify-center gap-3">
        {
          tags.map((tag) => (
            <li>
              <a
                href={`/tags/${tag}`}
                class="group border-border bg-surface text-text-dark hover:border-primary hover:bg-primary flex min-h-[44px] items-center rounded-lg border px-4 py-2 transition hover:text-white"
              >
                <FaHashtag className="mr-1 text-primary group-hover:text-white transition" />
                {humanize(tag || "")}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
