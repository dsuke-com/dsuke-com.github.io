---
import JsonLd from "@/components/JsonLd.astro";
import config from "@/config/config.json";
import Base from "@/layouts/Base.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import { postSlug } from "@/lib/utils/postUrl";
import { plainify, slugify } from "@/lib/utils/textConverter";
import PostSingle from "@/partials/PostSingle.astro";

export async function getStaticPaths() {
  const BLOG_FOLDER = "posts";
  const posts = await getSinglePage(BLOG_FOLDER);

  const paths = posts.map((post) => ({
    params: {
      single: postSlug(post),
    },
    props: { post },
  }));
  return paths;
}

const { post } = Astro.props;
const { title, meta_title, image, description, date, updated, categories } =
  post.data;

const siteUrl = Astro.site ?? new URL(config.site.base_url);
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL(image || config.metadata.meta_image, siteUrl).href;
const category = categories?.[0];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: plainify(title),
  description: plainify(description || config.metadata.meta_description),
  image: [ogImage],
  datePublished: date?.toISOString(),
  dateModified: (updated ?? date)?.toISOString(),
  author: {
    "@type": "Person",
    name: config.author.name,
    url: new URL("/about", siteUrl).href,
  },
  publisher: {
    "@type": "Organization",
    name: config.site.title,
    logo: {
      "@type": "ImageObject",
      url: new URL(config.site.favicon, siteUrl).href,
    },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
  inLanguage: "ja-JP",
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { name: "ホーム", url: new URL("/", siteUrl).href },
    category && {
      name: category,
      url: new URL(`/categories/${slugify(category)}`, siteUrl).href,
    },
    { name: plainify(title), url: pageUrl },
  ]
    .filter(Boolean)
    .map((item, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: (item as { name: string }).name,
      item: (item as { url: string }).url,
    })),
};
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  ogType="article"
  publishedTime={date}
  modifiedTime={updated ?? date}
>
  <Fragment slot="head">
    <JsonLd schema={articleSchema} />
    <JsonLd schema={breadcrumbSchema} />
  </Fragment>
  <PostSingle post={post} />
</Base>
